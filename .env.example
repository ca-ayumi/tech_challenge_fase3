# Backend do modelo: mlx (Apple Silicon), transformers (CUDA/CPU) ou eco (deterministico).
BACKEND_LLM=mlx

# Modelos base
MODELO_BASE_MLX=mlx-community/Qwen2.5-1.5B-Instruct-4bit
MODELO_BASE_HF=Qwen/Qwen2.5-1.5B-Instruct

# Usa o adaptador LoRA treinado (false = modelo base, util para comparacao)
USAR_ADAPTADOR=true

# Geracao
TEMPERATURA=0.2
MAX_TOKENS=700
TOP_P=0.9

# Fine-tuning
LORA_CAMADAS=8
LORA_RANK=16
LORA_ESCALA=20.0
TREINO_ITERACOES=400
TREINO_LOTE=2
TREINO_LR=1e-5
TREINO_MAX_SEQ=1280
SEMENTE=42

# Recuperacao
RAG_TOP_K=4
RAG_MIN_SCORE=0.8

# Seguranca e auditoria
EXIGIR_VALIDACAO_HUMANA=true
MASCARAR_PII_LOGS=true
RETENCAO_AUDITORIA_ANOS=5

# ATENCAO: troque o sal em qualquer uso real. Ele define os pseudonimos da
# anonimizacao; com o sal, um pseudonimo pode ser reassociado ao valor original.
SAL_ANONIMIZACAO=troque-este-sal-em-producao
