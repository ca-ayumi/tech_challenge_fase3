# Backend do modelo: mlx (Apple Silicon), transformers (CUDA/CPU) ou eco (deterministico).
BACKEND_LLM=mlx

# Modelos base
MODELO_BASE_MLX=mlx-community/Qwen2.5-1.5B-Instruct-4bit
MODELO_BASE_HF=Qwen/Qwen2.5-1.5B-Instruct

# Usa o adaptador LoRA treinado (false = modelo base, util para comparacao)
USAR_ADAPTADOR=true

# Geracao
TEMPERATURA=0.2
MAX_TOKENS=700
TOP_P=0.9

# Fine-tuning
LORA_CAMADAS=8
LORA_RANK=16
LORA_ESCALA=20.0
TREINO_ITERACOES=400
TREINO_LOTE=2
TREINO_LR=1e-5
TREINO_MAX_SEQ=1280
SEMENTE=42

# Recuperacao
RAG_TOP_K=4
RAG_MIN_SCORE=0.8

# Seguranca e auditoria
EXIGIR_VALIDACAO_HUMANA=true
MASCARAR_PII_LOGS=true
RETENCAO_AUDITORIA_ANOS=5

# ATENCAO: troque o sal em qualquer uso real. Ele define os pseudonimos da
# anonimizacao; com o sal, um pseudonimo pode ser reassociado ao valor original.
SAL_ANONIMIZACAO=troque-este-sal-em-producao

# --- Fase 4: monitoramento multimodal ---

# Servicos cognitivos da Azure. Sem estas variaveis, audio e texto usam o
# backend offline. Use a mesma regiao nos dois recursos (camada F0 gratuita).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
AZURE_IDIOMA=pt-BR

# Alertas: severidade minima que gera alerta (critica, alta, moderada, baixa)
# e janela em que a mesma anomalia no mesmo paciente nao e alertada de novo.
SEVERIDADE_MINIMA_ALERTA=moderada
JANELA_SUPRESSAO_ALERTA_MIN=30

# Opcional: webhook de entrada do Teams ou do Slack para receber os alertas.
WEBHOOK_ALERTAS=

# Relogio do monitoramento: "cenario" usa o instante mais recente do prontuario
# sintetico (demonstracao); "real" usa a hora do sistema (producao).
RELOGIO=cenario
# Meia-vida (horas) do peso de uma anomalia no escore de risco do paciente.
MEIA_VIDA_RISCO_H=6
